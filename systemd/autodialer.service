# =============================================
# AutoDialer Ultimate - Systemd Service
# Версия: 3.0.0
# Расположение: /etc/systemd/system/autodialer.service
# =============================================
# ВКЛЮЧЕНЫ ВСЕ ИСПРАВЛЕНИЯ:
# - Ожидание зависимостей (ExecStartPre)
# - Лимиты ресурсов (NOFILE, NPROC, MemoryMax, CPUQuota)
# - Security hardening (NoNewPrivileges, ProtectSystem, PrivateTmp)
# - ReadWritePaths для degraded queue
# - Переменные окружения (LANG, LC_ALL, PYTHONUNBUFFERED)
# - Graceful shutdown (TimeoutStopSec, KillMode)
# - WatchdogSec для автоматического восстановления
# =============================================

[Unit]
Description=AutoDialer Ultimate Backend Service
Documentation=https://github.com/naumenis-code/AutoDialer-Ultimate

# Запуск после сети и всех зависимостей
After=network.target network-online.target
After=postgresql.service redis-server.service asterisk.service
Wants=network-online.target

# Требуем Redis (если упадет - сервис тоже)
Requires=redis-server.service

# Ждем синхронизации времени
After=time-sync.target
Wants=time-sync.target


[Service]
# =============================================
# Тип сервиса
# =============================================
Type=exec


# =============================================
# Пользователь и группа
# =============================================
User=autodialer
Group=autodialer


# =============================================
# Рабочая директория
# =============================================
WorkingDirectory=/opt/autodialer/backend


# =============================================
# Переменные окружения
# =============================================
Environment="PATH=/opt/autodialer/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/opt/autodialer/config/.env

# Python настройки
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/autodialer/backend"
Environment="PYTHONIOENCODING=utf-8"

# Локаль
Environment="LANG=ru_RU.UTF-8"
Environment="LC_ALL=ru_RU.UTF-8"
Environment="TZ=UTC"


# =============================================
# Ожидание зависимостей (graceful startup)
# =============================================
# Ждем PostgreSQL
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do if nc -z 127.0.0.1 5432; then break; fi; sleep 1; done'

# Ждем Redis
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do if nc -z 127.0.0.1 6379; then break; fi; sleep 1; done'

# Ждем Asterisk AMI
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do if nc -z 127.0.0.1 5038; then break; fi; sleep 1; done'

# Дополнительная пауза для стабилизации
ExecStartPre=/bin/sleep 3


# =============================================
# Запуск приложения (Gunicorn + Uvicorn)
# =============================================
ExecStart=/opt/autodialer/venv/bin/gunicorn \
    -w 4 \
    --threads 8 \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --access-logfile /opt/autodialer/logs/access.log \
    --error-logfile /opt/autodialer/logs/error.log \
    --log-level info \
    --timeout 120 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 10000 \
    --max-requests-jitter 1000 \
    --worker-connections 1000 \
    --backlog 2048 \
    --proxy-allow-from 127.0.0.1 \
    --forwarded-allow-ips 127.0.0.1 \
    --capture-output \
    --enable-stdio-inheritance \
    main:app


# =============================================
# Альтернатива: прямой Uvicorn (для разработки)
# =============================================
# ExecStart=/opt/autodialer/venv/bin/uvicorn \
#     main:app \
#     --host 127.0.0.1 \
#     --port 8000 \
#     --workers 4 \
#     --log-level info \
#     --access-log \
#     --proxy-headers


# =============================================
# Политика перезапуска
# =============================================
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5


# =============================================
# Лимиты ресурсов
# =============================================
# Файловые дескрипторы
LimitNOFILE=655350
LimitNOFILESoft=655350

# Процессы
LimitNPROC=655350
LimitNPROCSoft=655350

# Память (2GB максимум, 1.5GB предупреждение)
MemoryMax=2G
MemoryHigh=1.5G

# Блокировка памяти
LimitMEMLOCK=65536

# CPU (200% = 2 ядра)
CPUQuota=200%

# Задачи
TasksMax=infinity

# Адресное пространство
LimitAS=infinity
LimitRSS=infinity

# Core dump отключен
LimitCORE=0


# =============================================
# Приоритет и I/O
# =============================================
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0


# =============================================
# Таймауты
# =============================================
TimeoutStartSec=90
TimeoutStopSec=30
TimeoutAbortSec=10


# =============================================
# Watchdog (автоматическое восстановление)
# =============================================
# Приложение должно поддерживать watchdog (отправка keepalive)
WatchdogSec=30


# =============================================
# Режим завершения
# =============================================
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL


# =============================================
# Коды выхода
# =============================================
RestartForceExitStatus=0
SuccessExitStatus=0 143


# =============================================
# Директории времени выполнения
# =============================================
RuntimeDirectory=autodialer
RuntimeDirectoryMode=0755
StateDirectory=autodialer
StateDirectoryMode=0750
CacheDirectory=autodialer
CacheDirectoryMode=0750
LogsDirectory=autodialer
LogsDirectoryMode=0750


# =============================================
# Security Hardening
# =============================================

# Запрет повышения привилегий
NoNewPrivileges=yes

# Защита системных директорий
ProtectSystem=strict
ProtectHome=yes

# Приватные /tmp и /dev
PrivateTmp=yes
PrivateDevices=no

# Защита параметров ядра
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Ограничение сетевых протоколов
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Фильтрация системных вызовов
SystemCallFilter=@system-service @network-io @signal @timer @process @io-event @ipc
SystemCallArchitectures=native

# Защита hostname и часов
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes

# Запрет SUID/SGID
RestrictSUIDSGID=yes

# Очистка IPC при выходе
RemoveIPC=yes

# Блокировка personality
LockPersonality=yes

# Ограничение реального времени
RestrictRealtime=no


# =============================================
# Sandboxing (Read/Write пути)
# =============================================
# Только для чтения
ReadOnlyPaths=/usr /etc /opt/autodialer/backend

# Для чтения и записи
ReadWritePaths=/opt/autodialer/logs
ReadWritePaths=/opt/autodialer/data
ReadWritePaths=/opt/autodialer/tmp
ReadWritePaths=/tmp
ReadWritePaths=/var/log

# Недоступные пути
InaccessiblePaths=/root /home


# =============================================
# Логирование
# =============================================
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autodialer


[Install]
WantedBy=multi-user.target
