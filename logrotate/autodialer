# =============================================
# Logrotate Configuration for AutoDialer Ultimate
# =============================================

# Backend Application Logs
/opt/autodialer/logs/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 autodialer autodialer
    dateext
    dateformat -%Y%m%d
    maxage 30
    sharedscripts
    postrotate
        systemctl reload autodialer > /dev/null 2>&1 || true
    endscript
}

# Asterisk Full Log
/var/log/asterisk/full {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 asterisk asterisk
    sharedscripts
    postrotate
        /usr/sbin/asterisk -rx 'logger reload' > /dev/null 2>&1 || true
    endscript
}

