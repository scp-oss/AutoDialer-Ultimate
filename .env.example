# =============================================
# AutoDialer Ultimate Configuration
# =============================================

# FreePBX Server (Server-1)
FREEPBX_IP=192.168.1.100
EXTENSION_PASSWORD=your_extension_password_here

# Domain (optional, for HTTPS)
DOMAIN_NAME=

# Database
DB_PASSWORD=auto_generated_if_empty

# JWT Secret (auto-generated if empty)
JWT_SECRET=

# AMI Password (auto-generated if empty)
AMI_PASSWORD=

# Metrics
METRICS_USER=admin
METRICS_PASS=auto_generated_if_empty

# Dialer Settings
MAX_CALLS=50
DEFAULT_CPS=5
CALL_TIMEOUT=30
MAX_RETRIES=3

# TTS Voice (denis/irina)
TTS_VOICE=denis
