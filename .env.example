# =============================================
# AutoDialer Ultimate - Environment Configuration
# Version: 3.0.0
# =============================================
# Copy this file to .env and fill in your values
# =============================================

# =============================================
# FreePBX Server (Server-1) - REQUIRED
# =============================================
# IP address of your FreePBX server
FREEPBX_IP=192.168.1.100

# Password for SIP extension 291 on FreePBX
EXTENSION_PASSWORD=your_extension_password_here

# Backup FreePBX server (optional)
# BACKUP_FREEPBX_IP=192.168.1.101


# =============================================
# Domain Configuration (Optional)
# =============================================
# Domain name for HTTPS (Let's Encrypt)
DOMAIN_NAME=

# Server IP (auto-detected if empty)
# SERVER_IP=


# =============================================
# Database Configuration
# =============================================
# PostgreSQL settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=autodialer
DB_USER=autodialer

# Database password (auto-generated if empty)
DB_PASSWORD=

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50
DB_COMMAND_TIMEOUT=60


# =============================================
# Redis Configuration
# =============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Redis password (optional, leave empty for none)
REDIS_PASSWORD=

# Redis memory limit
REDIS_MAXMEMORY=256mb


# =============================================
# Asterisk AMI Configuration
# =============================================
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=autodialer

# AMI password (auto-generated if empty)
AMI_PASSWORD=

# Admin AMI password (for manual access)
# ADMIN_AMI_PASSWORD=admin_secret_2024

# Monitor AMI password (read-only)
# MONITOR_AMI_PASSWORD=monitor_secret_2024


# =============================================
# JWT Authentication
# =============================================
# Secret key for JWT (auto-generated if empty)
JWT_SECRET=

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiration (seconds)
ACCESS_TOKEN_EXPIRE=3600       # 1 hour
REFRESH_TOKEN_EXPIRE=604800    # 7 days


# =============================================
# Dialer Settings
# =============================================
# Maximum concurrent calls
MAX_CALLS=50

# Default calls per second
DEFAULT_CPS=5

# Call timeout in seconds
CALL_TIMEOUT=30

# Maximum retry attempts
MAX_RETRIES=3

# Caller ID for outbound calls
CALLER_ID=AutoDialer


# =============================================
# Retry Strategy
# =============================================
# Busy retry settings
RETRY_BUSY_MAX=2
RETRY_BUSY_DELAY=120

# No answer retry settings
RETRY_NOANSWER_MAX=3
RETRY_NOANSWER_DELAY=300

# Failed retry settings
RETRY_FAILED_MAX=1
RETRY_FAILED_DELAY=60


# =============================================
# TTS (Text-to-Speech) Settings
# =============================================
# TTS engine (piper)
TTS_ENGINE=piper

# Default voice (denis or irina)
TTS_VOICE=denis

# TTS model directory
TTS_MODEL_DIR=/var/lib/asterisk/sounds/tts/models

# TTS output directory
TTS_OUTPUT_DIR=/var/lib/asterisk/sounds/tts


# =============================================
# Audio Settings
# =============================================
# Audio files retention (days)
AUDIO_RETENTION_DAYS=30

# Maximum upload file size (MB)
MAX_UPLOAD_SIZE_MB=10

# Recording enabled
RECORDING_ENABLED=false

# Recording format (wav/mp3)
RECORDING_FORMAT=wav


# =============================================
# AMD (Answering Machine Detection)
# =============================================
# Enable AMD
AMD_ENABLED=false

# AMD settings (milliseconds)
AMD_INITIAL_SILENCE=2500
AMD_GREETING=1500
AMD_AFTER_GREETING_SILENCE=800
AMD_TOTAL_ANALYSIS_TIME=5000


# =============================================
# Metrics & Monitoring
# =============================================
# Metrics endpoint credentials
METRICS_USER=admin

# Metrics password (auto-generated if empty)
METRICS_PASS=

# Prometheus settings
PROMETHEUS_ENABLED=true


# =============================================
# CORS Settings
# =============================================
# Allowed origins (comma-separated, * for all)
CORS_ORIGINS=*


# =============================================
# Logging Configuration
# =============================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (console or json)
LOG_FORMAT=console

# Log file path
LOG_FILE=/opt/autodialer/logs/autodialer.log

# Access log file
ACCESS_LOG=/opt/autodialer/logs/access.log

# Error log file
ERROR_LOG=/opt/autodialer/logs/error.log


# =============================================
# System Settings
# =============================================
# Timezone
TZ=UTC

# Language
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8


# =============================================
# Security Settings
# =============================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Login rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# Session timeout (seconds)
SESSION_TIMEOUT=3600


# =============================================
# WebSocket Settings
# =============================================
# Enable WebSocket
WEBSOCKET_ENABLED=true

# WebSocket path
WEBSOCKET_PATH=/ws


# =============================================
# Email Notifications (Optional)
# =============================================
# SMTP settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=AutoDialer <noreply@autodialer.local>
# SMTP_TLS=true

# Alert email
# ALERT_EMAIL=admin@example.com


# =============================================
# Backup Settings
# =============================================
# Backup directory
# BACKUP_DIR=/opt/autodialer/backups

# Backup retention (days)
# BACKUP_RETENTION=30

# Auto backup enabled
# AUTO_BACKUP_ENABLED=false

# Backup schedule (cron expression)
# BACKUP_SCHEDULE="0 2 * * *"


# =============================================
# Development Settings
# =============================================
# Debug mode (NEVER enable in production!)
DEBUG=false

# Auto-reload (development only)
AUTO_RELOAD=false

# Show tracebacks in responses
SHOW_TRACEBACK=false


# =============================================
# Advanced Settings
# =============================================
# Asterisk version (auto-detected)
# ASTERISK_VERSION=21

# PJSIP transport
# PJSIP_TRANSPORT=udp

# SIP port
# SIP_PORT=5060

# RTP port range
# RTP_PORT_START=10000
# RTP_PORT_END=20000

# Maximum file descriptors
# MAX_FILE_DESCRIPTORS=655350

# Gunicorn worker settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=10000


# =============================================
# Feature Flags
# =============================================
# Enable/disable features
FEATURE_CALL_RECORDING=false
FEATURE_AMD=false
FEATURE_WEBSOCKET=true
FEATURE_API_KEYS=true
FEATURE_AUDIT_LOG=true
FEATURE_BLACKLIST=true
FEATURE_CONTACT_GROUPS=true
FEATURE_CAMPAIGN_SCHEDULE=true
FEATURE_BULK_IMPORT=true
FEATURE_TTS_GENERATION=true
FEATURE_METRICS=true


# =============================================
# Integration Settings
# =============================================
# Webhook URL for events (optional)
# WEBHOOK_URL=https://your-service.com/webhook

# Webhook secret
# WEBHOOK_SECRET=

# Slack webhook (optional)
# SLACK_WEBHOOK_URL=

# Telegram bot token (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# =============================================
# Generated Secrets (DO NOT EDIT)
# =============================================
# These are auto-generated during installation
# DB_PASSWORD=
# JWT_SECRET=
# AMI_PASSWORD=
# METRICS_PASS=
