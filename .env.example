# =============================================
# AutoDialer Ultimate - Файл конфигурации
# Версия: 3.0.0
# =============================================
# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env && nano .env
# =============================================

# =============================================
# Сервер FreePBX (Server-1) - ОБЯЗАТЕЛЬНО
# =============================================
# IP-адрес вашего сервера FreePBX
FREEPBX_IP=192.168.1.100

# Номер SIP extension на FreePBX (по умолчанию: 291)
# Укажите тот номер, который вам выделили на FreePBX
FREEPBX_EXTENSION=291

# Пароль для SIP extension на FreePBX
EXTENSION_PASSWORD=your_extension_password_here

# Резервный сервер FreePBX (необязательно)
# BACKUP_FREEPBX_IP=192.168.1.101


# =============================================
# Доменное имя (необязательно)
# =============================================
# Доменное имя для настройки HTTPS через Let's Encrypt
DOMAIN_NAME=

# IP-адрес сервера (определяется автоматически, если пусто)
# SERVER_IP=


# =============================================
# Настройки базы данных PostgreSQL
# =============================================
# Хост базы данных
DB_HOST=127.0.0.1

# Порт базы данных
DB_PORT=5432

# Имя базы данных
DB_NAME=autodialer

# Пользователь базы данных
DB_USER=autodialer

# Пароль базы данных (генерируется автоматически при установке)
DB_PASSWORD=

# Настройки пула соединений
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50
DB_COMMAND_TIMEOUT=60


# =============================================
# Настройки Redis
# =============================================
# Хост Redis
REDIS_HOST=127.0.0.1

# Порт Redis
REDIS_PORT=6379

# Пароль Redis (оставьте пустым, если не используется)
REDIS_PASSWORD=

# Лимит памяти Redis
REDIS_MAXMEMORY=256mb


# =============================================
# Настройки Asterisk AMI (Manager Interface)
# =============================================
# Хост AMI
AMI_HOST=127.0.0.1

# Порт AMI
AMI_PORT=5038

# Пользователь AMI
AMI_USER=autodialer

# Пароль AMI (генерируется автоматически при установке)
AMI_PASSWORD=

# Пароль администратора AMI (для ручного доступа)
# ADMIN_AMI_PASSWORD=admin_secret_2024

# Пароль мониторинга AMI (только чтение)
# MONITOR_AMI_PASSWORD=monitor_secret_2024


# =============================================
# JWT Аутентификация
# =============================================
# Секретный ключ для JWT (генерируется автоматически при установке)
JWT_SECRET=

# Алгоритм JWT
JWT_ALGORITHM=HS256

# Время жизни токенов (в секундах)
# 1 час
ACCESS_TOKEN_EXPIRE=3600
# 7 дней
REFRESH_TOKEN_EXPIRE=604800


# =============================================
# Настройки дозвона (Dialer)
# =============================================
# Максимальное количество одновременных звонков
MAX_CALLS=50

# Количество звонков в секунду по умолчанию (CPS)
DEFAULT_CPS=5

# Таймаут звонка в секундах
CALL_TIMEOUT=30

# Максимальное количество повторных попыток
MAX_RETRIES=3

# Caller ID для исходящих звонков
CALLER_ID=AutoDialer


# =============================================
# Стратегия повторных звонков (Retry)
# =============================================
# Настройки для статуса "Занято" (BUSY)
# Максимальное количество попыток
RETRY_BUSY_MAX=2
# Задержка между попытками (сек)
RETRY_BUSY_DELAY=120

# Настройки для статуса "Нет ответа" (NOANSWER)
# Максимальное количество попыток
RETRY_NOANSWER_MAX=3
# Задержка между попытками (сек)
RETRY_NOANSWER_DELAY=300

# Настройки для статуса "Ошибка" (FAILED)
# Максимальное количество попыток
RETRY_FAILED_MAX=1
# Задержка между попытками (сек)
RETRY_FAILED_DELAY=60


# =============================================
# Настройки TTS (Text-to-Speech)
# =============================================
# Движок TTS (доступен piper)
TTS_ENGINE=piper

# Голос по умолчанию (denis - мужской, irina - женский)
TTS_VOICE=denis

# Директория с моделями TTS
TTS_MODEL_DIR=/var/lib/asterisk/sounds/tts/models

# Директория для сохранения сгенерированных аудиофайлов
TTS_OUTPUT_DIR=/var/lib/asterisk/sounds/tts


# =============================================
# Настройки аудиофайлов
# =============================================
# Срок хранения аудиофайлов (дней)
AUDIO_RETENTION_DAYS=30

# Максимальный размер загружаемого файла (МБ)
MAX_UPLOAD_SIZE_MB=10

# Включить запись разговоров
RECORDING_ENABLED=false

# Формат записи разговоров (wav/mp3)
RECORDING_FORMAT=wav


# =============================================
# Расшифровка входящих звонков (Speech-to-Text)
# =============================================
# По умолчанию "none" - расшифровка выключена, даже если пакет установлен
# (app/services/transcription.py: TranscriptionService._detect_engine
# коротит на "none" раньше проверки доступности whisper/vosk). Пакет из
# app/requirements/stt.txt (`pip install -r app/requirements/stt.txt`)
# нужно поставить отдельно - он не входит в основной requirements.txt из-за
# размера (whisper тянет torch, ~2-3 ГБ).
TRANSCRIPTION_ENGINE=whisper

# Модель Whisper: tiny/base/small/medium/large - чем крупнее, тем точнее
# и медленнее, и тем БОЛЬШЕ памяти требует. ВАЖНО: каждый воркер gunicorn -
# отдельный процесс, и каждый грузит СВОЮ копию модели при первой же
# транскрибации (память не шарится между воркерами) - на "small" (4
# воркера по умолчанию) это легко даёт OOM на сервере с 3-4 ГБ RAM,
# подтверждено живьём (OOM killer убил весь backend после пары звонков).
# На небольшом/тестовом сервере используйте tiny или base; small/medium -
# только если реально хватает памяти (проверяйте: RAM / кол-во воркеров).
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu


# =============================================
# AMD (Определение автоответчика)
# =============================================
# Включить определение автоответчика
AMD_ENABLED=false

# Настройки AMD (в миллисекундах)
# Начальная тишина
AMD_INITIAL_SILENCE=2500
# Время приветствия
AMD_GREETING=1500
# Тишина после приветствия
AMD_AFTER_GREETING_SILENCE=800
# Общее время анализа
AMD_TOTAL_ANALYSIS_TIME=5000


# =============================================
# Метрики и мониторинг
# =============================================
# Логин для доступа к /metrics
METRICS_USER=admin

# Пароль для доступа к /metrics (генерируется автоматически)
METRICS_PASS=

# Включить Prometheus метрики
PROMETHEUS_ENABLED=true


# =============================================
# Настройки CORS
# =============================================
# Разрешённые источники (через запятую, * для всех)
CORS_ORIGINS=*


# =============================================
# Email (SMTP) - опционально
# =============================================
# Если SMTP_HOST не задан, email считается ненастроенным: приветственное
# письмо и письмо восстановления пароля просто логируются и не
# отправляются (не ошибка).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@autodialer.local
SMTP_FROM_NAME="AutoDialer Ultimate"

# Базовый URL приложения для ссылок в письмах (сброс пароля и т.п.)
APP_BASE_URL=http://localhost:8000


# =============================================
# Настройки логирования
# =============================================
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Формат логов (console или json)
LOG_FORMAT=console

# Путь к файлу лога
LOG_FILE=/opt/autodialer/logs/autodialer.log

# Путь к логу доступа
ACCESS_LOG=/opt/autodialer/logs/access.log

# Путь к логу ошибок
ERROR_LOG=/opt/autodialer/logs/error.log


# =============================================
# Системные настройки
# =============================================
# Часовой пояс
TZ=UTC

# Язык и локаль
LANG=ru_RU.UTF-8
LC_ALL=ru_RU.UTF-8


# =============================================
# Настройки безопасности
# =============================================
# Включить ограничение частоты запросов
RATE_LIMIT_ENABLED=true

# Максимальное количество запросов
RATE_LIMIT_REQUESTS=100

# Временное окно для ограничения (секунд)
RATE_LIMIT_WINDOW=60

# Ограничение попыток входа
LOGIN_RATE_LIMIT=5

# Временное окно для попыток входа (секунд)
LOGIN_RATE_WINDOW=300

# Таймаут сессии (секунд)
SESSION_TIMEOUT=3600


# =============================================
# Настройки WebSocket
# =============================================
# Включить WebSocket для real-time обновлений
WEBSOCKET_ENABLED=true

# Путь к WebSocket
WEBSOCKET_PATH=/ws


# =============================================
# Email уведомления (необязательно)
# =============================================
# Настройки SMTP сервера
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=AutoDialer <noreply@autodialer.local>
# SMTP_TLS=true

# Email для оповещений
# ALERT_EMAIL=admin@example.com


# =============================================
# Настройки резервного копирования
# =============================================
# Реализовано в scripts/15_backup_setup.sh (bare-metal, cron) и
# k8s/50-backup-cronjob.yaml (Kubernetes) — см. ROADMAP.md §3.7.

# Директория для резервных копий
# BACKUP_DIR=/opt/autodialer/backups

# Срок хранения резервных копий (дней)
# BACKUP_RETENTION=30

# Включить автоматическое резервное копирование
# AUTO_BACKUP_ENABLED=false

# Расписание резервного копирования (cron выражение)
# BACKUP_SCHEDULE="0 2 * * *"


# =============================================
# Настройки для разработки
# =============================================
# Режим отладки (НЕ включать в production!)
DEBUG=false

# Автоматическая перезагрузка при изменении кода
AUTO_RELOAD=false

# Показывать трассировку в ответах API
SHOW_TRACEBACK=false


# =============================================
# Расширенные настройки
# =============================================
# Версия Asterisk (определяется автоматически)
# ASTERISK_VERSION=21

# Транспорт PJSIP
# PJSIP_TRANSPORT=udp

# Порт SIP
# SIP_PORT=5060

# Диапазон портов RTP
# RTP_PORT_START=10000
# RTP_PORT_END=20000

# Максимальное количество файловых дескрипторов
# MAX_FILE_DESCRIPTORS=655350

# Настройки воркеров Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=10000


# =============================================
# Флаги функциональности (Feature Flags)
# =============================================
# Включение/отключение функций системы
# Запись разговоров
FEATURE_CALL_RECORDING=false
# Определение автоответчика
FEATURE_AMD=false
# WebSocket соединения
FEATURE_WEBSOCKET=true
# API ключи
FEATURE_API_KEYS=true
# Журнал аудита
FEATURE_AUDIT_LOG=true
# Чёрный список номеров
FEATURE_BLACKLIST=true
# Группы контактов
FEATURE_CONTACT_GROUPS=true
# Расписание кампаний
FEATURE_CAMPAIGN_SCHEDULE=true
# Массовый импорт контактов
FEATURE_BULK_IMPORT=true
# Генерация TTS
FEATURE_TTS_GENERATION=true
# Сбор метрик
FEATURE_METRICS=true


# =============================================
# Интеграции со сторонними сервисами
# =============================================
# Webhook URL для отправки событий
# WEBHOOK_URL=https://your-service.com/webhook

# Секрет для подписи webhook
# WEBHOOK_SECRET=

# Slack webhook для уведомлений
# SLACK_WEBHOOK_URL=

# Telegram бот для уведомлений
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# =============================================
# Сгенерированные секреты (НЕ РЕДАКТИРОВАТЬ)
# =============================================
# Эти значения генерируются автоматически при установке
# DB_PASSWORD=
# JWT_SECRET=
# AMI_PASSWORD=
# METRICS_PASS=
